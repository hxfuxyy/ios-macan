#!/bin/bash
XNUDEPS=${XNUDEPS:-$(cd "$(dirname "$0")/../.." && pwd)}
SDKH="$XNUDEPS/MacOSX13.3.sdk/System/Library/Frameworks/Kernel.framework/Headers"
def=""; hdr=""; impl=""
while [ $# -gt 0 ]; do case "$1" in
  --def) def="$2"; shift 2;; --header) hdr="$2"; shift 2;; --impl) impl="$2"; shift 2;;
  --) break;; *) shift;; esac; done
name="$(basename "$def" .iig)"
src="$(find "$SDKH" -name "$name.h" -path '*DriverKit*' | head -1)"
[ -z "$src" ] && src="$(find "$SDKH" -name "$name.h" | xargs grep -l 'iig(DriverKit' 2>/dev/null | head -1)"
if [ -z "$src" ]; then echo "iig shim: no pre-generated header for $name" >&2; exit 1; fi
cp "$src" "$hdr"
if [ -f "$XNUDEPS/iig-impl/$name.iig.cpp" ]; then cp "$XNUDEPS/iig-impl/$name.iig.cpp" "$impl"
else echo "/* $name: no DriverKit implementation generated (iig shim) */" > "$impl"; fi
